# Copy to .env.local in apps/web, apps/desktop, apps/browser-extension, apps/mobile as needed.
# Never commit real values — see docs/design and the Phase 1 build plan (§3 Application Secrets).

# Supabase project (dev). Get from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# EXPO_PUBLIC_ variants for apps/mobile (Expo only exposes EXPO_PUBLIC_-prefixed vars to the client)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# service_role key — NEVER put this in a client .env. It belongs only in:
#   - Supabase Edge Function secrets (`supabase secrets set`)
#   - CI/CD secret store (GitHub Actions), for migration jobs
# Documented here only as a reminder of what must never appear above this line.
